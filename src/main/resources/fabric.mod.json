{
  "schemaVersion": 1,
  "id": "svc-fox-mobile",
  "version": "${version}",
  "name": "Fox Mobile",
  "description": "Fox Mobile phone client and optional local server operator.",
  "authors": [
    "YukiiNoTenshi"
  ],
  "contact": {},
  "license": "LicenseRef-Proprietary",
  "icon": "assets/svc-fox-mobile/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.yukiinotenshi.simplephonepromax.network.FabricLocalOperator"
    ],
    "client": [
      "dev.yukiinotenshi.simplephonepromax.SimpleVoiceCallClient"
    ],
    "voicechat": [
      "dev.yukiinotenshi.simplephonepromax.VoicechatEntrypoint"
    ]
  },
  "mixins": [
    "svc-fox-mobile.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${minimum_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
